# Copy to .env before running docker compose, then replace every placeholder.
# Generate strong secrets with: openssl rand -hex 32

# Signs sessions and visitor cookies. At least 32 characters.
KING_AI_SECRET=change-me-generate-with-openssl-rand-hex-32

# Encrypts supplier API keys and MCP headers at rest.
# Must differ from KING_AI_SECRET and be at least 32 characters.
KING_AI_ENCRYPTION_KEY=change-me-use-a-separate-openssl-rand-hex-32
# During key rotation, list retired keys here (comma separated) so old data stays readable.
KING_AI_PREVIOUS_ENCRYPTION_KEYS=

MYSQL_ROOT_PASSWORD=REPLACE_WITH_STRONG_PASSWORD
MYSQL_DATABASE=king_ai
MYSQL_USER=king
MYSQL_PASSWORD=REPLACE_WITH_STRONG_PASSWORD
# JDBC TLS mode and RSA public-key retrieval for the MySQL connection.
MYSQL_SSL_MODE=REQUIRED
MYSQL_ALLOW_PUBLIC_KEY_RETRIEVAL=false

REDIS_PASSWORD=REPLACE_WITH_STRONG_PASSWORD
# Enable when the Redis endpoint terminates TLS (e.g. a managed Redis).
REDIS_SSL_ENABLED=false

MINIO_ROOT_USER=REPLACE_WITH_NON_DEFAULT_USER
MINIO_ROOT_PASSWORD=REPLACE_WITH_STRONG_PASSWORD
# API token for a Milvus/Zilliz endpoint with authentication enabled; empty for the bundled Milvus.
MILVUS_TOKEN=

# Initial platform administrator, created only when no administrator exists.
# Password must be 12-72 characters and contain both letters and digits.
KING_AI_ADMIN_USERNAME=admin
KING_AI_ADMIN_PASSWORD=REPLACE_ME

# Browser-facing origin(s) allowed to send cookie-authenticated writes, comma separated.
KING_AI_ALLOWED_ORIGINS=https://ai.example.com
# Keep private-network blocking on; add trusted internal LLM/MCP hosts explicitly if needed.
KING_AI_BLOCK_PRIVATE_NETWORKS=true
KING_AI_ALLOWED_OUTBOUND_HOSTS=

# Set true only when Nginx or another trusted reverse proxy terminates TLS.
KING_AI_TRUST_FORWARDED_HEADERS=true
KING_AI_COOKIE_SECURE=true

# Compose image references. On an air-gapped host point these at the imported tags
# (king-ai-api:<version> / king-ai-ui:<version>) so Compose does not build from source.
KING_AI_API_IMAGE=king-ai-api:local
KING_AI_UI_IMAGE=king-ai-ui:local

# Host ports. The API is bound to localhost; expose it only through the UI proxy.
API_BIND=127.0.0.1
API_PORT=8080
UI_PORT=80
# UI container limits (Compose deploy.resources). The static Nginx image needs little.
UI_CPU_LIMIT=1.0
UI_MEMORY_LIMIT=256M
UI_CPU_RESERVATION=0.25
UI_MEMORY_RESERVATION=64M

# Seed/expose the built-in demo agent, Mock model and demo MCP server.
# Enable it for a trial stack; keep false for a real deployment.
KING_AI_DEMO_ENABLED=false

# Compliance export storage: local (API volume) or s3 (S3-compatible, bucket must exist).
# For the bundled MinIO, create the bucket once:
#   docker compose exec minio mc alias set local http://127.0.0.1:9000 "$MINIO_ROOT_USER" "$MINIO_ROOT_PASSWORD"
#   docker compose exec minio mc mb local/king-ai-exports
KING_AI_EXPORT_STORAGE=local
# KING_AI_EXPORT_S3_ENDPOINT=http://minio:9000
# KING_AI_EXPORT_S3_ACCESS_KEY=REPLACE_WITH_MINIO_ROOT_USER
# KING_AI_EXPORT_S3_SECRET_KEY=REPLACE_WITH_MINIO_ROOT_PASSWORD
# KING_AI_EXPORT_S3_BUCKET=king-ai-exports
# KING_AI_EXPORT_S3_PREFIX=exports
# KING_AI_EXPORT_S3_REGION=

PUBLIC_RATE_LIMIT_PER_MINUTE=20

# Vector layout. shared = one Milvus collection per embedding dimension, partitioned by
# space_id (default); per-kb = legacy one-collection-per-knowledge-base layout.
# MILVUS_COLLECTION_MODE=shared
# MILVUS_COLLECTION_PREFIX=king_ai_chunks_v2
# MILVUS_PARTITIONS_NUM=64

# Maximum concurrently streaming chats per space (0 disables the limit).
KING_AI_CHAT_MAX_CONCURRENT_PER_SPACE=4

# FinOps: per-space monthly token budget. A space with quota 0 is unlimited;
# set the real quota through PUT /api/finops/quota. Prices are per 1M tokens and
# only estimate cost — the ledger records them at write time.
KING_AI_FINOPS_QUOTA_ENABLED=true
KING_AI_FINOPS_CURRENCY=USD
KING_AI_FINOPS_DEFAULT_INPUT_PRICE=0
KING_AI_FINOPS_DEFAULT_OUTPUT_PRICE=0

# Offline license (Sprint 3). Signing recipe: deploy/airgap/license/README.md.
# With enabled=true a missing, tampered or expired license blocks API startup.
KING_AI_LICENSE_ENABLED=false
KING_AI_LICENSE_FILE=/app/license/license.json
# Raw 32-byte Ed25519 public key as base64url/base64, or a PEM public key.
KING_AI_LICENSE_PUBLIC_KEY=
# Host directory mounted at /app/license; must contain license.json when enabled.
KING_AI_LICENSE_DIR=./deploy/airgap/license

# SSO/OIDC. Register this redirect URI at the identity provider:
#   https://<host>/api/auth/oidc/callback
KING_AI_SSO_ENABLED=false
KING_AI_OIDC_ISSUER=
KING_AI_OIDC_CLIENT_ID=
KING_AI_OIDC_CLIENT_SECRET=
KING_AI_OIDC_REDIRECT_URI=
# Space that receives role-claim mappings; empty means automatic/default only.
KING_AI_OIDC_DEFAULT_SPACE_CODE=
KING_AI_OIDC_DEFAULT_ROLE=VIEWER

# TOTP second factor for local password logins.
KING_AI_MFA_ENABLED=true

# OCR for scanned PDFs and image uploads; the API image ships tesseract (chi_sim+eng).
KING_AI_OCR_ENABLED=false

JAVA_OPTS=-XX:MaxRAMPercentage=75 -XX:+ExitOnOutOfMemoryError
# Observability overlay (deploy/observability/docker-compose.yml).
# Required by Grafana; use a unique value of at least 16 characters.
GRAFANA_ADMIN_PASSWORD=REPLACE_WITH_STRONG_PASSWORD
# The local overlay samples every trace. Production should use 0.1 or lower.
KING_AI_TRACE_SAMPLE=1.0
