# Copy to .env before running docker compose, then replace every placeholder.
# Generate strong secrets with: openssl rand -hex 32

# Signs sessions and visitor cookies. At least 32 characters.
KING_AI_SECRET=change-me-generate-with-openssl-rand-hex-32

# Encrypts supplier API keys and MCP headers at rest.
# Must differ from KING_AI_SECRET and be at least 32 characters.
KING_AI_ENCRYPTION_KEY=change-me-use-a-separate-openssl-rand-hex-32
# During key rotation, list retired keys here (comma separated) so old data stays readable.
KING_AI_PREVIOUS_ENCRYPTION_KEYS=

MYSQL_ROOT_PASSWORD=REPLACE_WITH_STRONG_PASSWORD
MYSQL_DATABASE=king_ai
MYSQL_USER=king
MYSQL_PASSWORD=REPLACE_WITH_STRONG_PASSWORD

REDIS_PASSWORD=REPLACE_WITH_STRONG_PASSWORD

MINIO_ROOT_USER=REPLACE_WITH_NON_DEFAULT_USER
MINIO_ROOT_PASSWORD=REPLACE_WITH_STRONG_PASSWORD

# Initial platform administrator, created only when no administrator exists.
# Password must be 12-72 characters and contain both letters and digits.
KING_AI_ADMIN_USERNAME=admin
KING_AI_ADMIN_PASSWORD=REPLACE_ME

# Browser-facing origin(s) allowed to send cookie-authenticated writes, comma separated.
KING_AI_ALLOWED_ORIGINS=https://ai.example.com
# Keep private-network blocking on; add trusted internal LLM/MCP hosts explicitly if needed.
KING_AI_BLOCK_PRIVATE_NETWORKS=true
KING_AI_ALLOWED_OUTBOUND_HOSTS=

# Set true only when Nginx or another trusted reverse proxy terminates TLS.
KING_AI_TRUST_FORWARDED_HEADERS=true
KING_AI_COOKIE_SECURE=true

# Host ports. The API is bound to localhost; expose it only through the UI proxy.
API_BIND=127.0.0.1
API_PORT=8080
UI_PORT=80

# Seed/expose the built-in demo agent, Mock model and demo MCP server.
# Enable it for a trial stack; keep false for a real deployment.
KING_AI_DEMO_ENABLED=false

PUBLIC_RATE_LIMIT_PER_MINUTE=20

# Maximum concurrently streaming chats per space (0 disables the limit).
KING_AI_CHAT_MAX_CONCURRENT_PER_SPACE=4

JAVA_OPTS=-XX:MaxRAMPercentage=75 -XX:+ExitOnOutOfMemoryError
# Observability overlay (deploy/observability/docker-compose.yml).
# Required by Grafana; use a unique value of at least 16 characters.
GRAFANA_ADMIN_PASSWORD=REPLACE_WITH_STRONG_PASSWORD
# The local overlay samples every trace. Production should use 0.1 or lower.
KING_AI_TRACE_SAMPLE=1.0
